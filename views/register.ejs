<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head.ejs') %>

<body>
  <h1>Create an account</h1>

  <form action="/register" autocomplete="off" method="POST">
    <label for="username">Username:</label>
    <input type="text" id="username" name="username" maxlength="50" pattern="\S+" title="No spaces allowed" required>

    <br>

    <label for="password">Password:</label>
    <input type="password" id="password" name="password" required>

    <br>

    <button type="submit">Sign Up</button>
  </form>

  <p><span>Already have an account? </span><a href="/login">Log in</a></p>

  <%- include('./partials/messages.ejs') %>
</body>
</html>