<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Profile</title>
</head>
<body>
  <% if (username) { %>
    <h1>Welcome <%= username %>!</h1>
    <p>This page should require authentication (not implemented yet).</p>
    <nav>
      <a href="/logout">Log out</a>
    </nav>
  <% } else { %>
    <h1>You are not logged in</h1>
    <p><a href="/login">Go to login</a></p>
  <% } %>
</body>
</html>